# ==============================================================================
# GUMAM — Environment Variables Template
# ==============================================================================
# INSTRUKSI:
# 1. Salin file ini: `cp .env.example .env`
# 2. Isi setiap nilai di bawah dengan kredensial asli Anda.
# 3. File .env SUDAH masuk ke .gitignore — JANGAN pernah commit file .env ke Git.
# 4. Semua variabel WAJIB menggunakan prefix VITE_ agar bisa diakses di client-side Vite.
# ==============================================================================

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Dapatkan dari: Firebase Console → Project Settings → Your Apps → Web App → SDK snippet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Dapatkan dari: https://aistudio.google.com/app/apikey
# KEAMANAN:
#   - Batas domain di Google Cloud Console → APIs & Services → Credentials
#   - Set kuota harian maksimum di Credentials untuk mencegah abuse
VITE_GEMINI_API_KEY=
